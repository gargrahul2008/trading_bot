# Per-account environment — copy to accounts/<name>/account.env and fill in.
# Loaded by systemd (bot@<name>, fyers-auth@<name>) and for manual one-shot commands.
# This file is gitignored: it names the account's whitelisted IP and must never be committed.

# Account identity (usually the account folder name).
ACCOUNT_ID=CHANGEME

# The user_key in fyers_auth.json for this account (may differ from ACCOUNT_ID).
FYERS_USER_KEY=CHANGEME

# This account's dedicated static proxy = its whitelisted static IP.
# All Fyers REST + auth traffic exits through here. Must be whitelisted in the Fyers app.
HTTPS_PROXY=http://10.0.0.CHANGEME:3128
HTTP_PROXY=http://10.0.0.CHANGEME:3128
