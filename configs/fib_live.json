    "min_impulse_pct": 0.25,
    "target_ext": 1.618,
    "stop_buffer_pct": 0.009,
    "use_trailing_stop": true
  },

  "mexc": {
    "secrets_file": "mexc_secrets.json"
  },

  "telegram": {
    "enabled": true,
    "secrets_file": "strategies/pct_ladder/secrets/telegram.json",
    "chat_id": "1042052650"
