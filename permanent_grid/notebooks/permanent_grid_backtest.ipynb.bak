    "        f\"{min(eq_daily['total_pnl'].values - np.maximum.accumulate(eq_daily['total_pnl'].values))/10_000_000*100:.2f}%\",\n",
    "        daily_cycles, daily_fills,\n",
    "        f\"₹{daily_pnl/daily_cycles:,.0f}\" if daily_cycles > 0 else '-',\n",
    "        'N/A (not modeled)', 'N/A'\n",
    "    ],\n",
    "    '5-Min Gross': [\n",
    "        f\"₹{eq5['total_pnl_gross'].iloc[-1]:,.0f}\",\n",
    "        f\"{eq5['total_pnl_gross'].iloc[-1]/10_000_000*100:.2f}%\",\n",
    "        f\"{min(eq5['total_pnl_gross'].values - np.maximum.accumulate(eq5['total_pnl_gross'].values))/10_000_000*100:.2f}%\",\n",
    "        min5_cycles, min5_fills,\n",
    "        f\"₹{eq5['realized_gross'].iloc[-1]/min5_cycles:,.0f}\" if min5_cycles > 0 else '-',\n",
    "        'N/A', 'N/A'\n",
    "    ],\n",
    "    '5-Min Net': [\n",
    "        f\"₹{eq5['total_pnl_net'].iloc[-1]:,.0f}\",\n",
    "        f\"{eq5['total_pnl_net'].iloc[-1]/10_000_000*100:.2f}%\",\n",
    "        f\"{min(eq5['total_pnl_net'].values - np.maximum.accumulate(eq5['total_pnl_net'].values))/10_000_000*100:.2f}%\",\n",
    "        min5_cycles, min5_fills,\n",
    "        f\"₹{eq5['realized_net'].iloc[-1]/min5_cycles:,.0f}\" if min5_cycles > 0 else '-',\n",
    "        f\"₹{eq5['realized_costs'].iloc[-1]:,.0f}\",\n",
    "        f\"{eq5['realized_costs'].iloc[-1]/eq5['realized_gross'].iloc[-1]*100:.1f}%\" if eq5['realized_gross'].iloc[-1] > 0 else '-'\n",
    "    ],\n",
    "})\n",
    "comp"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Transaction cost breakdown\n",
    "cost_model = CostModel()\n",
    "avg_trade_value = bt5.capital_per_stock / bt5.num_levels  # typical single-level trade value\n",
    "\n",
    "buy_brok = cost_model.brokerage_per_order\n",
    "buy_stt = avg_trade_value * cost_model.stt_pct\n",
    "buy_exch = avg_trade_value * cost_model.exchange_pct\n",
    "buy_sebi = avg_trade_value * cost_model.sebi_pct\n",
    "buy_stamp = avg_trade_value * cost_model.stamp_duty_pct\n",
    "buy_gst = (buy_brok + buy_exch + buy_sebi) * cost_model.gst_pct\n",
    "buy_slip = avg_trade_value * cost_model.slippage_pct\n",
    "buy_total = cost_model.buy_cost(avg_trade_value)\n",
    "\n",
    "sell_brok = cost_model.brokerage_per_order\n",
    "sell_stt = avg_trade_value * cost_model.stt_pct\n",
    "sell_exch = avg_trade_value * cost_model.exchange_pct\n",
    "sell_sebi = avg_trade_value * cost_model.sebi_pct\n",
    "sell_gst = (sell_brok + sell_exch + sell_sebi) * cost_model.gst_pct\n",
    "sell_slip = avg_trade_value * cost_model.slippage_pct\n",
    "sell_total = cost_model.sell_cost(avg_trade_value)\n",
    "\n",
    "rt = cost_model.round_trip_cost(avg_trade_value)\n",
    "rt_pct = cost_model.round_trip_pct(avg_trade_value)\n",
    "\n",
    "cost_df = pd.DataFrame({\n",
    "    'Component': ['Brokerage', 'STT (0.1%)', 'Exchange (0.00297%)', 'SEBI (0.0001%)',\n",
    "                   'Stamp Duty (0.015%)', 'GST (18% on fees)', 'Slippage (0.05%)', 'TOTAL'],\n",
    "    'Buy Side (₹)': [buy_brok, buy_stt, buy_exch, buy_sebi, buy_stamp, buy_gst, buy_slip, buy_total],\n",
    "    'Sell Side (₹)': [sell_brok, sell_stt, sell_exch, sell_sebi, 0, sell_gst, sell_slip, sell_total],\n",
    "    'Round Trip (₹)': [buy_brok+sell_brok, buy_stt+sell_stt, buy_exch+sell_exch,\n",
    "                        buy_sebi+sell_sebi, buy_stamp, buy_gst+sell_gst,\n",
    "                        buy_slip+sell_slip, rt],\n",
    "})\n",
    "cost_df[['Buy Side (₹)', 'Sell Side (₹)', 'Round Trip (₹)']] = cost_df[['Buy Side (₹)', 'Sell Side (₹)', 'Round Trip (₹)']].round(2)\n",
    "\n",
    "print(f\"Average trade value per level: ₹{avg_trade_value:,.0f}\")\n",
    "print(f\"Round-trip cost: ₹{rt:.2f} ({rt_pct:.3f}% of trade value)\")\n",
    "grid_profit = avg_trade_value * bt5.grid_pct\n",
    "print(f\"Grid profit per cycle (gross): ₹{grid_profit:,.0f}\")\n",
    "print(f\"Cost as % of grid profit: {rt/grid_profit*100:.1f}%\")\n",
    "print()\n",
    "\n",
    "# Pie chart of cost components\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "components = cost_df.iloc[:-1]\n",
    "sizes = components['Round Trip (₹)'].values\n",
    "labels = components['Component'].values\n",
    "colors = plt.cm.Set3(np.linspace(0, 1, len(sizes)))\n",
    "\n",
    "axes[0].pie(sizes, labels=labels, autopct='%1.1f%%', colors=colors, startangle=90)\n",
    "axes[0].set_title(f'Round-Trip Cost Breakdown\\n(₹{rt:.0f} per cycle)')\n",
    "\n",
    "# Total costs over time by category (approximate from total)\n",
    "all5_grids = list(bt5.grids.values()) + bt5.retired_grids\n",
    "total_costs = sum(g.realized_costs for g in all5_grids)\n",
    "total_gross = sum(g.realized_gross for g in all5_grids)\n",
    "total_net = sum(g.realized_net for g in all5_grids)\n",
    "\n",
    "axes[1].bar(['Gross PnL', 'Costs', 'Net PnL'],\n",
    "            [total_gross/100000, total_costs/100000, total_net/100000],\n",
    "            color=['green', 'orange', 'blue'], alpha=0.7)\n",
    "axes[1].set_ylabel('₹ Lakhs')\n",
    "axes[1].set_title('PnL Waterfall: Gross → Costs → Net')\n",
    "axes[1].grid(True, alpha=0.3, axis='y')\n",
    "for i, v in enumerate([total_gross, total_costs, total_net]):\n",
    "    axes[1].text(i, v/100000, f'₹{v/100000:.1f}L', ha='center', va='bottom', fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "cost_df"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cycle density: fills per month — daily vs 5-min\n",
    "from collections import Counter\n",
    "\n",
    "# Daily bar fills per month\n",
    "_bt_daily = bt_custom if 'bt_custom' in dir() else bt\n",
    "daily_all = list(_bt_daily.grids.values()) + _bt_daily.retired_grids\n",
    "daily_sells_month = Counter()\n",
    "for g in daily_all:\n",
    "    for f in g.fills:\n",
    "        if f.side == 'SELL':\n",
    "            m = pd.Timestamp(f.date).to_period('M')\n",
    "            daily_sells_month[m] += 1\n",
    "\n",
    "# 5-min fills per month\n",
    "min5_all = list(bt5.grids.values()) + bt5.retired_grids\n",
    "min5_sells_month = Counter()\n",
    "for g in min5_all:\n",
    "    for f in g.fills:\n",
    "        if f.side == 'SELL':\n",
    "            m = pd.Timestamp(f.date).to_period('M')\n",
    "            min5_sells_month[m] += 1\n",
    "\n",
    "all_months = sorted(set(daily_sells_month.keys()) | set(min5_sells_month.keys()))\n",
    "daily_counts = [daily_sells_month.get(m, 0) for m in all_months]\n",
    "min5_counts = [min5_sells_month.get(m, 0) for m in all_months]\n",
    "\n",
    "fig, axes = plt.subplots(2, 1, figsize=(16, 8))\n",
    "\n",
    "x = range(len(all_months))\n",
    "w = 0.35\n",
    "axes[0].bar([i - w/2 for i in x], daily_counts, w, label='Daily Bar', color='blue', alpha=0.7)\n",
    "axes[0].bar([i + w/2 for i in x], min5_counts, w, label='5-Min', color='green', alpha=0.7)\n",
    "axes[0].set_xticks(x)\n",
    "axes[0].set_xticklabels([str(m) for m in all_months], rotation=45, ha='right', fontsize=8)\n",
    "axes[0].set_ylabel('Sell Fills (Cycles)')\n",
    "axes[0].set_title('Monthly Grid Cycles: Daily Bar vs 5-Minute Simulation')\n",
    "axes[0].legend()\n",
    "axes[0].grid(True, alpha=0.3, axis='y')\n",
    "\n",
    "# Ratio chart: 5-min / daily\n",
    "ratios = [m5/d if d > 0 else 0 for d, m5 in zip(daily_counts, min5_counts)]\n",
    "colors = ['green' if r >= 1 else 'red' for r in ratios]\n",
    "axes[1].bar(x, ratios, color=colors, alpha=0.6)\n",
    "axes[1].axhline(1.0, color='black', lw=1, linestyle='--', label='1:1')\n",
    "axes[1].set_xticks(x)\n",
    "axes[1].set_xticklabels([str(m) for m in all_months], rotation=45, ha='right', fontsize=8)\n",
    "axes[1].set_ylabel('Ratio (5-Min / Daily)')\n",
    "axes[1].set_title('5-Min Cycle Multiplier Over Daily Bar')\n",
    "axes[1].legend()\n",
    "axes[1].grid(True, alpha=0.3, axis='y')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "total_daily = sum(daily_counts)\n",
    "total_min5 = sum(min5_counts)\n",
    "print(f\"Total cycles — Daily: {total_daily}, 5-Min: {total_min5}\")\n",
    "print(f\"5-Min captures {total_min5/total_daily:.1%} of daily-bar cycles ({total_min5 - total_daily:+d} extra)\")\n",
    "print(f\"Average monthly cycles — Daily: {total_daily/len(all_months):.1f}, 5-Min: {total_min5/len(all_months):.1f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Grid % sensitivity WITH real costs — find optimal grid spacing\n",
    "importlib.reload(pgb5)\n",
    "from permanent_grid.backtest_5min import PermanentGridBacktest5Min, CostModel\n",
    "\n",
    "grid_pcts = [0.005, 0.0075, 0.01, 0.015, 0.02, 0.025, 0.03]\n",
    "sweep_results = []\n",
    "\n",
    "for gp in grid_pcts:\n",
    "    bt_s = PermanentGridBacktest5Min(\n",
    "        basket=basket, daily_data=daily_data,\n",
    "        data_5min=data_5min, nifty_5min=nifty_5min,\n",
    "        total_capital=10_000_000, grid_pct=gp, runway_pct=0.25,\n",
    "        sim_start=SIM_START,\n",
    "        universe=universe, universe_data=universe_data,\n",
    "        universe_5min=data_5min,\n",
    "        entry_mode='basket', cost_model=CostModel(),\n",
    "    )\n",
    "    bt_s.run()\n",
    "    eq_s = bt_s.get_equity_curve()\n",
    "\n",
    "    pnl_net = eq_s['total_pnl_net'].values\n",
    "    pnl_gross = eq_s['total_pnl_gross'].values\n",
    "    dd_net = min(pnl_net - np.maximum.accumulate(pnl_net))\n",
    "\n",
    "    all_g = list(bt_s.grids.values()) + bt_s.retired_grids\n",
    "    total_costs = sum(g.realized_costs for g in all_g)\n",
    "    total_gross = sum(g.realized_gross for g in all_g)\n",
    "    cycles = sum(g.grid_cycles for g in all_g)\n",
    "\n",
    "    sweep_results.append({\n",
    "        'Grid %': f\"{gp*100:.1f}%\",\n",
    "        'Gross PnL': pnl_gross[-1],\n",
    "        'Costs': total_costs,\n",
    "        'Net PnL': pnl_net[-1],\n",
    "        'Gross %': round(pnl_gross[-1] / 10_000_000 * 100, 2),\n",
    "        'Net %': round(pnl_net[-1] / 10_000_000 * 100, 2),\n",
    "        'Max DD %': round(dd_net / 10_000_000 * 100, 2),\n",
    "        'Cycles': cycles,\n",
    "        'Cost/Cycle': round(total_costs / cycles) if cycles > 0 else 0,\n",
    "        'Cost Drag %': round(total_costs / total_gross * 100, 1) if total_gross > 0 else 0,\n",
    "    })\n",
    "    print(f\"  {gp*100:.1f}%: Gross={sweep_results[-1]['Gross %']}%, \"\n",
    "          f\"Net={sweep_results[-1]['Net %']}%, \"\n",
    "          f\"DD={sweep_results[-1]['Max DD %']}%, \"\n",
    "          f\"Cycles={cycles}, \"\n",
    "          f\"CostDrag={sweep_results[-1]['Cost Drag %']}%\")\n",
    "\n",
    "df_sweep5 = pd.DataFrame(sweep_results)\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
    "\n",
    "axes[0].bar(df_sweep5['Grid %'], df_sweep5['Gross %'], alpha=0.4, color='green', label='Gross')\n",
    "axes[0].bar(df_sweep5['Grid %'], df_sweep5['Net %'], alpha=0.7, color='blue', label='Net')\n",
    "axes[0].set_ylabel('Return %')\n",
    "axes[0].set_title('Gross vs Net Return by Grid %')\n",
    "axes[0].legend()\n",
    "axes[0].grid(True, alpha=0.3, axis='y')\n",
    "\n",
    "axes[1].bar(df_sweep5['Grid %'], df_sweep5['Cost Drag %'], color='orange', alpha=0.7)\n",
    "axes[1].set_ylabel('Cost as % of Gross')\n",
    "axes[1].set_title('Cost Drag — Tighter Grids = Higher Cost Impact')\n",
    "axes[1].grid(True, alpha=0.3, axis='y')\n",
    "\n",
    "axes[2].plot(df_sweep5['Grid %'], df_sweep5['Net %'], 'bo-', lw=2, label='Net Return')\n",
    "axes[2].plot(df_sweep5['Grid %'], [abs(x) for x in df_sweep5['Max DD %']], 'rs--', lw=1.5, label='Max DD')\n",
    "axes[2].set_ylabel('%')\n",
    "axes[2].set_title('Net Return vs Max Drawdown')\n",
    "axes[2].legend()\n",
    "axes[2].grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "df_sweep5[['Grid %', 'Gross %', 'Net %', 'Max DD %', 'Cycles', 'Cost Drag %']]"
   ]
