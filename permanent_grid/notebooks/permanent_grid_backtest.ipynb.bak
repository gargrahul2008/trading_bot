   "source": [
    "# Multi-period sweep using master data\n",
    "import importlib\n",
    "import permanent_grid.backtest_5min as pgb5\n",
    "importlib.reload(pgb5)\n",
    "from permanent_grid.backtest_5min import PermanentGridBacktest5Min, CostModel\n",
    "\n",
    "periods = [\n",
    "    ('COVID crash',    '2020-01-01', '2021-12-31'),\n",
    "    ('2022 bear',      '2022-01-01', '2023-06-30'),\n",
    "    ('2023 rally',     '2023-01-01', '2024-06-30'),\n",
    "    ('2024-25',        '2024-01-01', '2025-12-31'),\n",
    "    ('Full 2020-2025', '2020-01-01', '2025-12-31'),\n",
    "]\n",
    "\n",
    "period_results = []\n",
    "period_eqs = {}\n",
    "\n",
    "for label, s, e in periods:\n",
    "    print(f\"Running {label} ({s} → {e})...\", end=' ')\n",
    "    try:\n",
    "        bt_p = PermanentGridBacktest5Min.from_master(\n",
    "            master_pkl=MASTER_PKL, sim_start=s, sim_end=e,\n",
    "            total_capital=CAPITAL, grid_pct=GRID_PCT_M, runway_pct=RUNWAY_M,\n",
    "            cost_model=CostModel(), n_basket=N_BASKET,\n",
    "        )\n",
    "        bt_p.run()\n",
    "        eq_p = bt_p.get_equity_curve()\n",
    "\n",
    "        pnl_net = eq_p['total_pnl_net'].values\n",
    "        pnl_gross = eq_p['total_pnl_gross'].values\n",
    "        dd = min(pnl_net - np.maximum.accumulate(pnl_net))\n",
    "        all_g = list(bt_p.grids.values()) + bt_p.retired_grids\n",
    "        days = len(eq_p)\n",
    "        ann_factor = 252 / days if days > 0 else 1\n",
    "\n",
    "        period_results.append({\n",
    "            'Period': label, 'Start': s, 'End': e, 'Days': days,\n",
    "            'Gross %': round(pnl_gross[-1] / CAPITAL * 100, 2),\n",
    "            'Net %': round(pnl_net[-1] / CAPITAL * 100, 2),\n",
    "            'Ann. Net %': round(pnl_net[-1] / CAPITAL * 100 * ann_factor, 1),\n",
    "            'Max DD %': round(dd / CAPITAL * 100, 2),\n",
    "            'Cycles': sum(g.grid_cycles for g in all_g),\n",
    "            'Replacements': bt_p.replacements,\n",
    "            'Index Changes': len([ev for ev in bt_p.events if 'INDEX CHANGE' in ev]),\n",
    "        })\n",
    "        period_eqs[label] = eq_p\n",
    "        print(f\"Net={period_results[-1]['Net %']}%, DD={period_results[-1]['Max DD %']}%\")\n",
    "    except Exception as ex:\n",
    "        print(f\"FAILED: {ex}\")\n",
    "        period_results.append({'Period': label, 'Start': s, 'End': e, 'Error': str(ex)})\n",
    "\n",
    "df_periods = pd.DataFrame(period_results)\n",
    "df_periods"
   ]
  },
