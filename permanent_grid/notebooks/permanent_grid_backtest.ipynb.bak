    "prev_state = eq['market_state'].iloc[0]\n",
    "start_date = eq['date'].iloc[0]\n",
    "for idx, row in eq.iterrows():\n",
    "    if row['market_state'] != prev_state or idx == len(eq) - 1:\n",
    "        color = state_colors.get(prev_state, 'white')\n",
    "        if color != 'white':\n",
    "            axes[0].axvspan(start_date, row['date'], alpha=0.3, color=color)\n",
    "        prev_state = row['market_state']\n",
    "        start_date = row['date']\n",
