    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(f'Max Drawdown: ₹{min(drawdown):,.0f} ({min(drawdown)/10_000_000*100:.2f}%)')\n",
    "print(f'Current Drawdown: ₹{drawdown[-1]:,.0f}')"
   ]
