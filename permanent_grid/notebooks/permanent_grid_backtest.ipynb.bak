   "source": [
    "# Per-stock summary table\n",
    "_bt = bt_custom if 'bt_custom' in dir() else bt\n",
    "all_grids = list(_bt.grids.values()) + _bt.retired_grids\n",
    "\n",
    "rows = []\n",
    "for g in all_grids:\n",
    "    unr = 0\n",
    "    if g.inventory > 0:\n",
    "        df = _bt.daily.get(g.symbol)\n",
    "        if df is not None and not df.empty:\n",
    "            last_px = float(df.iloc[-1]['close'])\n",
    "            unr = g.inventory * g.shares_per_level * last_px - g.inventory_cost\n",
    "    state = g.state.value\n",
    "    if g in _bt.retired_grids:\n",
    "        state = \"REPLACED\"\n",
    "    rows.append({\n",
    "        'Stock': g.symbol,\n",
    "        'State': state,\n",
    "        'Entry': g.entry_price,\n",
    "        'Fills': len(g.fills),\n",
    "        'Cycles': g.grid_cycles,\n",
    "        'Realized': round(g.realized_pnl),\n",
    "        'Unrealized': round(unr),\n",
    "        'Total': round(g.realized_pnl + unr),\n",
    "        'Inventory': g.inventory,\n",
    "    })\n",
    "\n",
    "df_stocks = pd.DataFrame(rows).sort_values('Total', ascending=False)\n",
    "print(f\"Total grids tracked: {len(all_grids)} ({len(_bt.grids)} active, {len(_bt.retired_grids)} retired)\")\n",
    "if _bt.replacements > 0:\n",
    "    unique_syms = {g.symbol for g in all_grids}\n",
    "    print(f\"Stock replacements: {_bt.replacements} ({len(unique_syms)} unique stocks used)\")\n",
    "df_stocks"
   ]
