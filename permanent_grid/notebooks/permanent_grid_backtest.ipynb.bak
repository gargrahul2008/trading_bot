    "## 11. Monthly Returns Heatmap"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "_bt = bt_custom if 'bt_custom' in dir() else bt\n",
    "eq_m = _bt.get_equity_curve()\n",
    "eq_m['date'] = pd.to_datetime(eq_m['date'])\n",
    "eq_m['month'] = eq_m['date'].dt.to_period('M')\n",
    "\n",
    "monthly = eq_m.groupby('month').agg(\n",
    "    pnl_start=('total_pnl', 'first'),\n",
    "    pnl_end=('total_pnl', 'last'),\n",
    ").reset_index()\n",
    "monthly['pnl_change'] = monthly['pnl_end'] - monthly['pnl_start']\n",
    "monthly['year'] = monthly['month'].dt.year\n",
    "monthly['mon'] = monthly['month'].dt.month\n",
    "\n",
    "pivot = monthly.pivot(index='year', columns='mon', values='pnl_change').fillna(0) / 100000\n",
    "pivot.columns = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][:len(pivot.columns)]\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(14, 3))\n",
    "im = ax.imshow(pivot.values, cmap='RdYlGn', aspect='auto',\n",
    "               vmin=-pivot.abs().values.max(), vmax=pivot.abs().values.max())\n",
    "ax.set_xticks(range(len(pivot.columns))); ax.set_xticklabels(pivot.columns)\n",
    "ax.set_yticks(range(len(pivot.index))); ax.set_yticklabels(pivot.index)\n",
    "for i in range(len(pivot.index)):\n",
    "    for j in range(len(pivot.columns)):\n",
    "        v = pivot.iloc[i, j]\n",
    "        if v != 0:\n",
    "            ax.text(j, i, f'{v:.1f}L', ha='center', va='center', fontsize=9)\n",
    "ax.set_title('Monthly PnL Change (₹ Lakhs)')\n",
    "plt.colorbar(im, ax=ax, shrink=0.8)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
