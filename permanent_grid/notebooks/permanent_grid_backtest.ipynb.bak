    "min5_cycles = sum(g.grid_cycles for g in all5)\n",
    "min5_fills = sum(len(g.fills) for g in all5)\n",
    "\n",
    "comp = pd.DataFrame({\n",
    "    'Metric': ['Total PnL', 'Return %', 'Max Drawdown %', 'Grid Cycles', 'Total Fills',\n",
