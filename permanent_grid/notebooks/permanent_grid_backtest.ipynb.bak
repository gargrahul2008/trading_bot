  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7b. Grid Slot Timeline — Replacement Flow\n",
    "\n",
    "Each row is one of the 10 grid slots. Colored bars show which stock occupied that slot over time."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Grid Slot Timeline — which stock occupied each of the 10 slots over time\n",
    "_bt = bt_custom if 'bt_custom' in dir() else bt\n",
    "all_grids = list(_bt.grids.values()) + _bt.retired_grids\n",
    "\n",
    "# Reconstruct slot assignments: basket order = initial slots, replacements inherit the slot\n",
    "slot_chains = {i: [] for i in range(len(basket))}\n",
    "sym_to_slot = {}\n",
    "\n",
    "# Initial assignment from basket order\n",
    "for i, item in enumerate(basket):\n",
    "    sym = item['symbol']\n",
    "    sym_to_slot[sym] = i\n",
    "\n",
    "# Walk events chronologically to track slot inheritance\n",
    "for ev in _bt.events:\n",
    "    if 'REPLACE' in ev and '→' in ev:\n",
    "        parts = ev.split()\n",
    "        idx_r = parts.index('REPLACE')\n",
    "        old_sym = parts[idx_r + 1]\n",
    "        new_sym = parts[idx_r + 3]\n",
    "        if old_sym in sym_to_slot:\n",
    "            slot = sym_to_slot[old_sym]\n",
    "            sym_to_slot[new_sym] = slot\n",
    "\n",
    "# Build slot occupancy from grid fills\n",
    "for g in all_grids:\n",
    "    if not g.fills:\n",
    "        continue\n",
    "    slot = sym_to_slot.get(g.symbol, -1)\n",
    "    if slot < 0:\n",
    "        continue\n",
    "    start = pd.Timestamp(g.fills[0].date)\n",
    "    end = pd.Timestamp(g.fills[-1].date)\n",
    "    slot_chains[slot].append((g.symbol, start, end, g.realized_pnl))\n",
    "\n",
    "import matplotlib.patches as mpatches\n",
    "from matplotlib.colors import hsv_to_rgb\n",
    "\n",
    "# Assign a unique color to each symbol\n",
    "unique_syms = sorted({g.symbol for g in all_grids if g.fills})\n",
    "sym_colors = {}\n",
    "for i, s in enumerate(unique_syms):\n",
    "    hue = i / max(len(unique_syms), 1)\n",
    "    sym_colors[s] = hsv_to_rgb((hue, 0.55, 0.85))\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(18, 5))\n",
    "yticks, ylabels = [], []\n",
    "\n",
    "for slot_id in range(len(basket)):\n",
    "    y = len(basket) - 1 - slot_id\n",
    "    yticks.append(y)\n",
    "    ylabels.append(f'Slot {slot_id}')\n",
    "    for sym, start, end, rpnl in slot_chains[slot_id]:\n",
    "        width = (end - start).days\n",
    "        if width < 5:\n",
    "            width = 5\n",
    "        color = sym_colors.get(sym, 'gray')\n",
    "        ax.barh(y, width, left=(start - pd.Timestamp(SIM_START)).days,\n",
    "                height=0.7, color=color, edgecolor='white', linewidth=0.5)\n",
    "        if width > 40:\n",
    "            label = f'{sym}\\n₹{rpnl/1000:.0f}k' if rpnl != 0 else sym\n",
    "            ax.text((start - pd.Timestamp(SIM_START)).days + width / 2, y,\n",
    "                    label, ha='center', va='center', fontsize=6, fontweight='bold')\n",
    "\n",
    "ax.set_yticks(yticks)\n",
    "ax.set_yticklabels(ylabels)\n",
    "ax.set_xlabel(f'Days since {SIM_START}')\n",
    "ax.set_title('Grid Slot Timeline — Stock Replacements Over Time')\n",
    "ax.grid(True, alpha=0.2, axis='x')\n",
    "\n",
    "# Legend (top symbols by appearance count)\n",
    "from collections import Counter\n",
    "sym_counts = Counter()\n",
    "for chains in slot_chains.values():\n",
    "    for sym, *_ in chains:\n",
    "        sym_counts[sym] += 1\n",
    "top_syms = [s for s, _ in sym_counts.most_common(15)]\n",
    "patches = [mpatches.Patch(color=sym_colors[s], label=s) for s in top_syms if s in sym_colors]\n",
    "ax.legend(handles=patches, loc='upper left', bbox_to_anchor=(1.01, 1), fontsize=8, ncol=1)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Per-ticker charts: price curve + buy/sell markers + active shading + cumulative PnL\n",
    "_bt = bt_custom if 'bt_custom' in dir() else bt\n",
    "all_grids = list(_bt.grids.values()) + _bt.retired_grids\n",
    "\n",
    "# Group grids by symbol (a stock can appear multiple times if re-entered in different slots)\n",
    "from collections import defaultdict\n",
    "grids_by_sym = defaultdict(list)\n",
    "for g in all_grids:\n",
    "    if g.fills:\n",
    "        grids_by_sym[g.symbol].append(g)\n",
    "\n",
    "# Sort symbols: best total realized PnL first\n",
    "sym_order = sorted(grids_by_sym.keys(),\n",
    "                   key=lambda s: sum(g.realized_pnl for g in grids_by_sym[s]), reverse=True)\n",
    "\n",
    "n_stocks = len(sym_order)\n",
    "fig, axes = plt.subplots(n_stocks, 1, figsize=(18, 4.5 * n_stocks), squeeze=False)\n",
    "\n",
    "for row, sym in enumerate(sym_order):\n",
    "    ax = axes[row, 0]\n",
    "    grids = grids_by_sym[sym]\n",
    "\n",
    "    # Get full price data for this stock\n",
    "    df = _bt.daily.get(sym)\n",
    "    if df is None or df.empty:\n",
    "        ax.set_title(f'{sym} — no price data')\n",
    "        continue\n",
    "    df = df.sort_values('date').copy()\n",
    "    df['date'] = pd.to_datetime(df['date'])\n",
    "    df_bt = df[df['date'] >= pd.Timestamp(SIM_START)]\n",
    "\n",
    "    ax.plot(df_bt['date'], df_bt['close'], color='#333', lw=1, alpha=0.8, label='Close')\n",
    "\n",
    "    # Shade active grid periods and plot fills for each grid instance\n",
    "    cum_pnl_pts = []  # (date, cumulative_pnl) across all grid instances\n",
    "    total_rpnl = 0\n",
    "\n",
    "    for gi, g in enumerate(sorted(grids, key=lambda g: g.fills[0].date)):\n",
    "        fill_dates = [pd.Timestamp(f.date) for f in g.fills]\n",
    "        active_start = fill_dates[0]\n",
    "        active_end = fill_dates[-1]\n",
    "\n",
    "        # Shade active period\n",
    "        shade_alpha = 0.08 + 0.04 * (gi % 3)\n",
    "        ax.axvspan(active_start, active_end, alpha=shade_alpha, color='steelblue')\n",
    "\n",
    "        # Plot buy/sell markers\n",
    "        buys = [(pd.Timestamp(f.date), f.price) for f in g.fills if f.side == 'BUY']\n",
    "        sells = [(pd.Timestamp(f.date), f.price) for f in g.fills if f.side == 'SELL']\n",
    "        stops = [(pd.Timestamp(f.date), f.price) for f in g.fills if f.side == 'STOP_LOSS']\n",
    "\n",
    "        if buys:\n",
    "            ax.scatter([b[0] for b in buys], [b[1] for b in buys],\n",
    "                       marker='^', color='green', s=18, alpha=0.6, zorder=3)\n",
    "        if sells:\n",
    "            ax.scatter([s[0] for s in sells], [s[1] for s in sells],\n",
    "                       marker='v', color='red', s=18, alpha=0.6, zorder=3)\n",
    "        if stops:\n",
    "            ax.scatter([s[0] for s in stops], [s[1] for s in stops],\n",
    "                       marker='X', color='darkred', s=60, zorder=4)\n",
    "\n",
    "        # Build cumulative PnL points from fills\n",
    "        running = total_rpnl\n",
    "        for f in g.fills:\n",
    "            running += f.pnl\n",
    "            cum_pnl_pts.append((pd.Timestamp(f.date), running))\n",
    "        total_rpnl = running\n",
    "\n",
    "    # Plot cumulative realized PnL on right axis\n",
    "    if cum_pnl_pts:\n",
    "        ax2 = ax.twinx()\n",
    "        pnl_dates = [p[0] for p in cum_pnl_pts]\n",
    "        pnl_vals = [p[1] / 1000 for p in cum_pnl_pts]\n",
    "        ax2.plot(pnl_dates, pnl_vals, color='blue', lw=1.2, alpha=0.6, linestyle='--')\n",
    "        ax2.axhline(0, color='blue', lw=0.3, alpha=0.3)\n",
    "        ax2.set_ylabel('Cum. PnL (₹k)', color='blue', fontsize=9)\n",
    "        ax2.tick_params(axis='y', labelcolor='blue', labelsize=8)\n",
    "\n",
    "    # Title with summary stats\n",
    "    total_fills = sum(len(g.fills) for g in grids)\n",
    "    total_cycles = sum(g.grid_cycles for g in grids)\n",
    "    n_instances = len(grids)\n",
    "    state_str = grids[-1].state.value if grids[-1] in _bt.grids.values() else 'REPLACED'\n",
    "    ax.set_title(f'{sym}  |  PnL: ₹{total_rpnl/1000:.0f}k  |  {total_fills} fills, '\n",
    "                 f'{total_cycles} cycles  |  {n_instances} grid instance(s)  |  {state_str}',\n",
    "                 fontsize=11, fontweight='bold',\n",
    "                 color='green' if total_rpnl > 0 else 'red')\n",
    "    ax.set_ylabel('Price (₹)', fontsize=9)\n",
    "    ax.grid(True, alpha=0.2)\n",
    "    ax.tick_params(labelsize=8)\n",
    "\n",
    "# Common legend at top\n",
    "import matplotlib.patches as mpatches\n",
    "from matplotlib.lines import Line2D\n",
    "legend_elements = [\n",
    "    Line2D([0], [0], color='#333', lw=1, label='Close Price'),\n",
    "    Line2D([0], [0], marker='^', color='green', lw=0, markersize=7, label='Buy'),\n",
    "    Line2D([0], [0], marker='v', color='red', lw=0, markersize=7, label='Sell'),\n",
    "    Line2D([0], [0], marker='X', color='darkred', lw=0, markersize=9, label='Stop Loss'),\n",
    "    Line2D([0], [0], color='blue', lw=1.2, linestyle='--', label='Cum. PnL (₹k)'),\n",
    "    mpatches.Patch(color='steelblue', alpha=0.15, label='Active Grid Period'),\n",
    "]\n",
    "fig.legend(handles=legend_elements, loc='upper center', ncol=6, fontsize=10,\n",
    "           bbox_to_anchor=(0.5, 1.005))\n",
    "plt.tight_layout(rect=[0, 0, 1, 0.995])\n",
    "plt.show()\n",
    "\n",
    "print(f'\\nPlotted {n_stocks} unique tickers across {len(all_grids)} grid instances')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Parameter Sensitivity — Grid %, Runway, Initial Levels\n",
    "\n",
    "Sweep different configurations to find the optimal setup."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Parameter sweep — change the scenarios dict and re-run\n",
    "import importlib\n",
    "import permanent_grid.backtest as pgb\n",
    "importlib.reload(pgb)\n",
    "from permanent_grid.backtest import PermanentGridBacktest\n",
    "\n",
    "scenarios = {\n",
    "    '0.5% grid, 25% rwy':  {'grid_pct': 0.005, 'runway_pct': 0.25},\n",
    "    '0.75% grid, 25% rwy': {'grid_pct': 0.0075, 'runway_pct': 0.25},\n",
    "    '1% grid, 25% rwy':    {'grid_pct': 0.01,  'runway_pct': 0.25},\n",
    "    '1% grid, 30% rwy':    {'grid_pct': 0.01,  'runway_pct': 0.30},\n",
    "    '1.5% grid, 30% rwy':  {'grid_pct': 0.015, 'runway_pct': 0.30},\n",
    "    '2% grid, 30% rwy':    {'grid_pct': 0.02,  'runway_pct': 0.30},\n",
    "}\n",
    "\n",
    "results = []\n",
    "for name, params in scenarios.items():\n",
    "    bt_s = PermanentGridBacktest(\n",
    "        basket=basket, daily_data=daily_data, nifty_df=nifty_df,\n",
    "        total_capital=10_000_000, sim_start=SIM_START,\n",
    "        universe=universe, universe_data=universe_data,\n",
    "        **params,\n",
    "    )\n",
    "    bt_s.run()\n",
    "    eq_s = bt_s.get_equity_curve()\n",
    "    pnl_s = eq_s['total_pnl'].values\n",
    "    rm = np.maximum.accumulate(pnl_s)\n",
    "    dd = min(pnl_s - rm)\n",
    "\n",
    "    all_g = list(bt_s.grids.values()) + bt_s.retired_grids\n",
    "    results.append({\n",
    "        'Scenario': name,\n",
    "        'Realized': round(eq_s['realized'].iloc[-1]),\n",
    "        'Unrealized': round(eq_s['unrealized'].iloc[-1]),\n",
    "        'Total PnL': round(eq_s['total_pnl'].iloc[-1]),\n",
    "        'Return%': round(eq_s['total_pnl'].iloc[-1] / 10_000_000 * 100, 2),\n",
    "        'Max DD%': round(dd / 10_000_000 * 100, 2),\n",
    "        'Cycles': sum(g.grid_cycles for g in all_g),\n",
    "        'Stops': sum(1 for f in [f for g in all_g for f in g.fills] if f.side == 'STOP_LOSS'),\n",
    "        'Replacements': bt_s.replacements,\n",
    "    })\n",
    "    print(f\"  {name}: Return={results[-1]['Return%']}%, DD={results[-1]['Max DD%']}%, Cycles={results[-1]['Cycles']}, Repl={results[-1]['Replacements']}\")\n",
    "\n",
    "df_sweep = pd.DataFrame(results)\n",
    "df_sweep"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Sweep comparison chart\n",
    "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
    "\n",
    "colors = ['green' if v > 0 else 'red' for v in df_sweep['Total PnL']]\n",
    "axes[0].barh(df_sweep['Scenario'], df_sweep['Total PnL'] / 100000, color=colors, alpha=0.7)\n",
    "axes[0].axvline(0, color='black', lw=0.5)\n",
    "axes[0].set_xlabel('Total PnL (₹ Lakhs)')\n",
    "axes[0].set_title('Total PnL by Config')\n",
    "\n",
    "axes[1].barh(df_sweep['Scenario'], df_sweep['Max DD%'], color='red', alpha=0.5)\n",
    "axes[1].set_xlabel('Max Drawdown %')\n",
    "axes[1].set_title('Max Drawdown by Config')\n",
