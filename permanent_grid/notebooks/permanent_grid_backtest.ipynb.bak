   "source": [
    "## 14. Dynamic Universe Backtest — Any Date Range (2019+)\n",
    "\n",
    "Uses `master_data.pkl` (all 62 Nifty50 stocks, daily from 2017, 5-min from 2019).\n",
    "- **Auto basket selection** at sim start using vol+correlation scoring\n",
    "- **Dynamic index rebalancing** mid-simulation (Nifty50 changes applied automatically)\n",
    "- **Stock replacement** respects current index composition\n",
    "\n",
    "Just change `START` and `END` below — no separate data fetching needed."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ╔══════════════════════════════════════════════════════╗\n",
    "# ║  CHANGE THESE AND RE-RUN                            ║\n",
    "# ╚══════════════════════════════════════════════════════╝\n",
    "START      = '2024-01-01'      # any date from 2019-01-01 onward\n",
    "END        = '2026-05-31'      # end date\n",
    "CAPITAL    = 10_000_000        # Rs 1 Cr\n",
    "GRID_PCT_M = 0.02              # 2% grid step\n",
    "RUNWAY_M   = 0.25              # 25% runway\n",
    "N_BASKET   = 10                # stocks in basket\n",
    "# ════════════════════════════════════════════════════════\n",
    "\n",
    "import importlib\n",
    "import permanent_grid.backtest_5min as pgb5\n",
    "importlib.reload(pgb5)\n",
    "from permanent_grid.backtest_5min import PermanentGridBacktest5Min, CostModel\n",
    "\n",
    "MASTER_PKL = '/root/trading_bot/permanent_grid/data/master_data.pkl'\n",
    "\n",
    "bt_master = PermanentGridBacktest5Min.from_master(\n",
    "    master_pkl=MASTER_PKL,\n",
    "    sim_start=START, sim_end=END,\n",
    "    total_capital=CAPITAL,\n",
    "    grid_pct=GRID_PCT_M, runway_pct=RUNWAY_M,\n",
    "    cost_model=CostModel(),\n",
    "    n_basket=N_BASKET,\n",
    ")\n",
    "bt_master.run();"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Equity curve + drawdown for master backtest\n",
    "eq_m = bt_master.get_equity_curve()\n",
    "eq_m['date'] = pd.to_datetime(eq_m['date'])\n",
    "\n",
    "fig, axes = plt.subplots(3, 1, figsize=(16, 12), gridspec_kw={'height_ratios': [3, 1, 1]})\n",
    "\n",
    "# PnL curves\n",
    "axes[0].plot(eq_m['date'], eq_m['total_pnl_gross'] / 100000, label='Gross PnL', color='green', lw=1.5, alpha=0.8)\n",
    "axes[0].plot(eq_m['date'], eq_m['total_pnl_net'] / 100000, label='Net PnL', color='black', lw=2)\n",
    "axes[0].fill_between(eq_m['date'], eq_m['total_pnl_gross'] / 100000, eq_m['total_pnl_net'] / 100000,\n",
    "                     alpha=0.15, color='red', label='Cost Drag')\n",
    "axes[0].axhline(0, color='gray', lw=0.5)\n",
    "axes[0].set_ylabel('PnL (₹ Lakhs)')\n",
    "axes[0].set_title(f'Dynamic Universe Backtest — {START} to {END} | {GRID_PCT_M*100}% grid, ₹{CAPITAL/10_000_000:.0f}Cr')\n",
    "axes[0].legend(loc='upper left')\n",
    "axes[0].grid(True, alpha=0.3)\n",
    "\n",
    "# Color background by market state\n",
    "state_colors = {'NORMAL': 'white', 'CAUTION': '#fff3cd', 'STRESS': '#f8d7da',\n",
    "                'CRASH_DEPLOY': '#dc3545', 'RECOVERY': '#d4edda'}\n",
    "prev_state = eq_m['market_state'].iloc[0]\n",
    "start_date = eq_m['date'].iloc[0]\n",
    "for idx, row in eq_m.iterrows():\n",
    "    if row['market_state'] != prev_state or idx == len(eq_m) - 1:\n",
    "        color = state_colors.get(prev_state, 'white')\n",
    "        if color != 'white':\n",
    "            axes[0].axvspan(start_date, row['date'], alpha=0.3, color=color)\n",
    "        prev_state = row['market_state']\n",
    "        start_date = row['date']\n",
    "\n",
    "# Drawdown\n",
    "pnl_net = eq_m['total_pnl_net'].values\n",
    "running_max = np.maximum.accumulate(pnl_net)\n",
    "drawdown = pnl_net - running_max\n",
    "axes[1].fill_between(eq_m['date'], drawdown / 100000, alpha=0.5, color='red')\n",
    "axes[1].set_ylabel('Drawdown (₹L)')\n",
    "axes[1].grid(True, alpha=0.3)\n",
    "\n",
    "max_dd_idx = np.argmin(drawdown)\n",
    "max_dd = drawdown[max_dd_idx]\n",
    "axes[1].annotate(f'Max DD: ₹{max_dd/100000:.1f}L ({max_dd/CAPITAL*100:.1f}%)',\n",
    "                xy=(eq_m['date'].iloc[max_dd_idx], max_dd/100000),\n",
    "                fontsize=9, color='darkred', fontweight='bold')\n",
    "\n",
    "# Active grids\n",
    "axes[2].fill_between(eq_m['date'], eq_m['active'], alpha=0.5, color='steelblue')\n",
    "axes[2].set_ylabel('Active Grids')\n",
    "axes[2].set_ylim(0, N_BASKET + 2)\n",
    "axes[2].grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Summary stats\n",
    "total_gross = eq_m['total_pnl_gross'].iloc[-1]\n",
    "total_net = eq_m['total_pnl_net'].iloc[-1]\n",
    "total_costs = eq_m['realized_costs'].iloc[-1]\n",
    "print(f\"Gross PnL:  ₹{total_gross:,.0f} ({total_gross/CAPITAL*100:.2f}%)\")\n",
    "print(f\"Net PnL:    ₹{total_net:,.0f} ({total_net/CAPITAL*100:.2f}%)\")\n",
    "print(f\"Costs:      ₹{total_costs:,.0f}\")\n",
    "print(f\"Max DD:     ₹{max_dd:,.0f} ({max_dd/CAPITAL*100:.2f}%)\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Per-stock results table (master backtest)\n",
    "all_m = list(bt_master.grids.values()) + bt_master.retired_grids\n",
    "\n",
    "rows = []\n",
    "for g in all_m:\n",
    "    unr = 0\n",
    "    if g.inventory > 0:\n",
    "        df = bt_master.daily.get(g.symbol)\n",
    "        if df is not None and not df.empty:\n",
    "            last_px = float(df.iloc[-1]['close'])\n",
    "            unr = g.inventory * g.shares_per_level * last_px - g.inventory_cost\n",
    "    state = g.state.value\n",
    "    if g in bt_master.retired_grids:\n",
    "        state = \"REPLACED\"\n",
    "    rows.append({\n",
    "        'Stock': g.symbol, 'State': state, 'Entry': round(g.entry_price, 2),\n",
    "        'Fills': len(g.fills), 'Cycles': g.grid_cycles,\n",
    "        'Gross': round(g.realized_gross), 'Costs': round(g.realized_costs),\n",
    "        'Net': round(g.realized_net), 'Unrealized': round(unr),\n",
    "        'Total': round(g.realized_net + unr), 'Inventory': g.inventory,\n",
    "    })\n",
    "\n",
    "df_m_stocks = pd.DataFrame(rows).sort_values('Total', ascending=False)\n",
    "\n",
    "# Aggregate by unique symbol\n",
    "agg = df_m_stocks.groupby('Stock').agg(\n",
    "    Instances=('Stock', 'count'),\n",
    "    Fills=('Fills', 'sum'), Cycles=('Cycles', 'sum'),\n",
    "    Gross=('Gross', 'sum'), Costs=('Costs', 'sum'),\n",
    "    Net=('Net', 'sum'), Unrealized=('Unrealized', 'sum'),\n",
    "    Total=('Total', 'sum'), Inventory=('Inventory', 'sum'),\n",
    ").sort_values('Total', ascending=False)\n",
    "\n",
    "print(f\"Total grids: {len(all_m)} ({len(bt_master.grids)} active, {len(bt_master.retired_grids)} retired)\")\n",
    "print(f\"Unique stocks used: {len(agg)}\")\n",
    "print(f\"Replacements: {bt_master.replacements}\")\n",
    "print(f\"Index changes applied: {len([e for e in bt_master.events if 'INDEX CHANGE' in e])}\")\n",
    "print()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(16, max(5, len(agg) * 0.35)))\n",
    "colors = ['green' if v > 0 else 'red' for v in agg['Total']]\n",
    "ax.barh(agg.index, agg['Total'] / 1000, color=colors, alpha=0.7)\n",
    "ax.set_xlabel('Total PnL (₹ thousands)')\n",
    "ax.set_title('Per-Stock PnL (aggregated across all grid instances)')\n",
    "ax.axvline(0, color='black', lw=0.5)\n",
    "ax.grid(True, alpha=0.3, axis='x')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "agg.head(20)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Index rebalance events + replacement log\n",
    "events_idx = [e for e in bt_master.events if 'INDEX CHANGE' in e or 'REPLACE' in e or 'STOP_LOSS' in e]\n",
    "\n",
    "print(f\"=== Index Changes & Replacements ({len(events_idx)} events) ===\\n\")\n",
    "for e in events_idx:\n",
    "    print(e)\n",
    "\n",
    "# Timeline of replacements\n",
