   "source": [
    "# Daily vs 5-Minute equity curve comparison\n",
    "_bt_daily = bt_custom if 'bt_custom' in dir() else bt\n",
    "eq_daily = _bt_daily.get_equity_curve()\n",
    "eq_daily['date'] = pd.to_datetime(eq_daily['date'])\n",
    "\n",
    "eq5 = bt5.get_equity_curve()\n",
    "eq5['date'] = pd.to_datetime(eq5['date'])\n",
    "\n",
    "fig, axes = plt.subplots(2, 1, figsize=(16, 10), gridspec_kw={'height_ratios': [3, 1]})\n",
    "\n",
    "# Equity curves\n",
    "axes[0].plot(eq_daily['date'], eq_daily['total_pnl'] / 100000,\n",
    "             label='Daily Bar (no costs)', color='blue', lw=2, alpha=0.8)\n",
    "axes[0].plot(eq5['date'], eq5['total_pnl_gross'] / 100000,\n",
    "             label='5-Min Gross (no costs)', color='green', lw=2, alpha=0.8)\n",
    "axes[0].plot(eq5['date'], eq5['total_pnl_net'] / 100000,\n",
    "             label='5-Min Net (with costs)', color='red', lw=2)\n",
    "axes[0].fill_between(eq5['date'],\n",
    "                     eq5['total_pnl_gross'] / 100000,\n",
    "                     eq5['total_pnl_net'] / 100000,\n",
