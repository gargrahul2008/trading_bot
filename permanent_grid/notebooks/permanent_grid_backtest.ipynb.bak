    "    print(f\"\\n--- {len(repl_events)} stock replacements over {START} to {END} ---\")\n",
    "    print(f\"Average: 1 replacement every {(pd.Timestamp(END) - pd.Timestamp(START)).days / max(len(repl_events),1):.0f} days\")\n"
   ]
