   "source": [
    "## 9. Custom Single Run\n",
    "\n",
    "Change parameters below and re-run to test any configuration."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ╔══════════════════════════════════════════════════════╗\n",
    "# ║  CHANGE THESE VALUES AND RE-RUN THIS CELL           ║\n",
    "# ╚══════════════════════════════════════════════════════╝\n",
    "CAPITAL        = 10_000_000    # Total capital (Rs)\n",
    "GRID_PCT       = 0.02          # Grid step (0.01 = 1%)\n",
    "RUNWAY_PCT     = 0.25          # Downside runway (0.25 = 25%)\n",
    "INITIAL_LEVELS = None          # None = support-based pro-rata, or set int\n",
    "CUSTOM_START   = SIM_START     # 'YYYY-MM-DD' or SIM_START\n",
    "CUSTOM_END     = None          # 'YYYY-MM-DD' or None for full range\n",
    "DYNAMIC_REPL   = True          # True = scan universe for replacement on exit\n",
    "ENTRY_MODE     = 'basket'      # 'basket' = pre-assign 10, 'universe' = scan all, staggered\n",
    "MAX_ENTRY_WEEK = 3             # Max new entries per week (universe mode only)\n",
    "# ════════════════════════════════════════════════════════\n",
    "\n",
    "import importlib\n",
    "import permanent_grid.backtest as pgb\n",
    "importlib.reload(pgb)\n",
    "from permanent_grid.backtest import PermanentGridBacktest\n",
    "\n",
    "bt_custom = PermanentGridBacktest(\n",
    "    basket=basket, daily_data=daily_data, nifty_df=nifty_df,\n",
    "    total_capital=CAPITAL, grid_pct=GRID_PCT,\n",
    "    runway_pct=RUNWAY_PCT, initial_levels=INITIAL_LEVELS,\n",
    "    sim_start=CUSTOM_START, sim_end=CUSTOM_END,\n",
    "    universe=universe, universe_data=universe_data,\n",
    "    dynamic_replacement=DYNAMIC_REPL,\n",
    "    entry_mode=ENTRY_MODE,\n",
    "    max_entries_per_week=MAX_ENTRY_WEEK,\n",
    ")\n",
    "bt_custom.run()"
   ]
  },
