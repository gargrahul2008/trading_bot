   "source": [
    "# Multi-period comparison charts\n",
    "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
    "\n",
    "valid = df_periods.dropna(subset=['Net %'])\n",
    "\n",
    "# Net return by period\n",
    "colors = ['green' if v > 0 else 'red' for v in valid['Net %']]\n",
    "axes[0].barh(valid['Period'], valid['Net %'], color=colors, alpha=0.7)\n",
    "axes[0].axvline(0, color='black', lw=0.5)\n",
    "axes[0].set_xlabel('Net Return %')\n",
    "axes[0].set_title('Net Return by Period')\n",
    "axes[0].grid(True, alpha=0.3, axis='x')\n",
    "\n",
    "# Annualized return vs max DD\n",
    "axes[1].scatter(valid['Max DD %'].abs(), valid['Ann. Net %'], s=100, c=colors, edgecolors='black', zorder=3)\n",
    "for _, row in valid.iterrows():\n",
    "    axes[1].annotate(row['Period'], (abs(row['Max DD %']), row['Ann. Net %']),\n",
    "                    fontsize=8, ha='left', va='bottom')\n",
    "axes[1].set_xlabel('Max Drawdown % (abs)')\n",
    "axes[1].set_ylabel('Annualized Net Return %')\n",
    "axes[1].set_title('Risk-Return by Period')\n",
    "axes[1].grid(True, alpha=0.3)\n",
    "\n",
    "# Overlay equity curves (normalized to start at 0)\n",
    "for label, eq_p in period_eqs.items():\n",
    "    eq_p_copy = eq_p.copy()\n",
    "    eq_p_copy['date'] = pd.to_datetime(eq_p_copy['date'])\n",
    "    day_num = (eq_p_copy['date'] - eq_p_copy['date'].iloc[0]).dt.days\n",
    "    axes[2].plot(day_num, eq_p_copy['total_pnl_net'] / 100000, lw=1.5, label=label)\n",
    "axes[2].axhline(0, color='gray', lw=0.5)\n",
    "axes[2].set_xlabel('Days from Start')\n",
    "axes[2].set_ylabel('Net PnL (₹ Lakhs)')\n",
    "axes[2].set_title('Equity Curves — All Periods Aligned')\n",
    "axes[2].legend(fontsize=8)\n",
    "axes[2].grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
