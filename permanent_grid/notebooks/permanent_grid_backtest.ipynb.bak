   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 14b. Multi-Period Comparison — Rolling Windows\n",
    "\n",
    "Run the same strategy across different market regimes to see consistency."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Index rebalance events + replacement log\n",
    "events_idx = [e for e in bt_master.events if 'INDEX CHANGE' in e or 'REPLACE' in e or 'STOP_LOSS' in e]\n",
    "\n",
    "print(f\"=== Index Changes & Replacements ({len(events_idx)} events) ===\\n\")\n",
    "for e in events_idx:\n",
    "    print(e)\n",
    "\n",
    "# Timeline of replacements\n",
    "repl_events = [e for e in bt_master.events if 'REPLACE' in e and '→' in e]\n",
    "if repl_events:\n",
    "    print(f\"\\n--- {len(repl_events)} stock replacements over {START} to {END} ---\")\n",
    "    print(f\"Average: 1 replacement every {(pd.Timestamp(END) - pd.Timestamp(START)).days / max(len(repl_events),1):.0f} days\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Per-stock results table (master backtest)\n",
    "all_m = list(bt_master.grids.values()) + bt_master.retired_grids\n",
    "\n",
    "rows = []\n",
    "for g in all_m:\n",
    "    unr = 0\n",
    "    if g.inventory > 0:\n",
    "        df = bt_master.daily.get(g.symbol)\n",
    "        if df is not None and not df.empty:\n",
    "            last_px = float(df.iloc[-1]['close'])\n",
    "            unr = g.inventory * g.shares_per_level * last_px - g.inventory_cost\n",
    "    state = g.state.value\n",
    "    if g in bt_master.retired_grids:\n",
    "        state = \"REPLACED\"\n",
    "    rows.append({\n",
    "        'Stock': g.symbol, 'State': state, 'Entry': round(g.entry_price, 2),\n",
    "        'Fills': len(g.fills), 'Cycles': g.grid_cycles,\n",
    "        'Gross': round(g.realized_gross), 'Costs': round(g.realized_costs),\n",
    "        'Net': round(g.realized_net), 'Unrealized': round(unr),\n",
    "        'Total': round(g.realized_net + unr), 'Inventory': g.inventory,\n",
    "    })\n",
    "\n",
    "df_m_stocks = pd.DataFrame(rows).sort_values('Total', ascending=False)\n",
    "\n",
    "# Aggregate by unique symbol (a stock may appear multiple times across slots)\n",
    "agg = df_m_stocks.groupby('Stock').agg(\n",
    "    Instances=('Stock', 'count'),\n",
    "    Fills=('Fills', 'sum'), Cycles=('Cycles', 'sum'),\n",
    "    Gross=('Gross', 'sum'), Costs=('Costs', 'sum'),\n",
    "    Net=('Net', 'sum'), Unrealized=('Unrealized', 'sum'),\n",
    "    Total=('Total', 'sum'), Inventory=('Inventory', 'sum'),\n",
    ").sort_values('Total', ascending=False)\n",
    "\n",
    "print(f\"Total grids: {len(all_m)} ({len(bt_master.grids)} active, {len(bt_master.retired_grids)} retired)\")\n",
    "print(f\"Unique stocks used: {len(agg)}\")\n",
    "print(f\"Replacements: {bt_master.replacements}\")\n",
    "print(f\"Index changes applied: {len([e for e in bt_master.events if 'INDEX CHANGE' in e])}\")\n",
    "print()\n",
    "\n",
    "# Top/bottom performers\n",
    "fig, ax = plt.subplots(figsize=(16, max(5, len(agg) * 0.35)))\n",
    "colors = ['green' if v > 0 else 'red' for v in agg['Total']]\n",
    "ax.barh(agg.index, agg['Total'] / 1000, color=colors, alpha=0.7)\n",
    "ax.set_xlabel('Total PnL (₹ thousands)')\n",
    "ax.set_title('Per-Stock PnL (aggregated across all grid instances)')\n",
    "ax.axvline(0, color='black', lw=0.5)\n",
    "ax.grid(True, alpha=0.3, axis='x')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "agg.head(20)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Permanent Grid Strategy — Backtest & Analysis\n",
    "\n",
    "Run 1% grids on 10 diversified Nifty50 blue-chip stocks with full rulebook:\n",
    "- **Rule 1:** Entry within ±10% of 200-DMA, not near 52w high, above 52w low by 15%\n",
    "- **Rule 2:** UPSIDE_OUT → re-anchor on pullback to 50-DMA or 3% dip\n",
    "- **Rule 3:** Hard stop at -35% (disabled during market stress)\n",
    "- **Rule 4:** Market state tracking (NORMAL → CAUTION → STRESS → CRASH_DEPLOY)\n",
    "- **Capital:** 80% grid / 20% crash reserve\n",
    "\n",
    "See `permanent_grid/RULEBOOK.md` for full rules."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Setup & Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load pre-fetched data (run select_basket_2023.py first if missing)\n",
    "DATA_PATH = '/root/trading_bot/permanent_grid/data/basket_3y.pkl'\n",
    "\n",
    "with open(DATA_PATH, 'rb') as f:\n",
    "    data = pickle.load(f)\n",
    "\n",
    "basket = data['basket']\n",
    "daily_data = data['daily_data']\n",
    "nifty_df = data['nifty_data']\n",
    "universe = data.get('universe')\n",
    "universe_data = data.get('universe_data')\n",
    "SIM_START = data.get('start_date', '2023-01-01')\n",
    "\n",
    "print(f'Selection period: {data.get(\"selection_period\", \"unknown\")}')\n",
    "print(f'Backtest starts:  {SIM_START}')\n",
    "print(f'Basket: {len(basket)} stocks')\n",
    "print(f'Universe: {len(universe_data) if universe_data else \"N/A\"} stocks (dynamic replacement {\"ON\" if universe_data else \"OFF\"})')\n",
    "print(f'Nifty50: {len(nifty_df)} days')\n",
    "for item in basket:\n",
    "    fsym = item['fyers_symbol']\n",
    "    df = daily_data.get(fsym)\n",
    "    if df is not None:\n",
    "        df2023 = df[df['date'] >= SIM_START]\n",
    "        print(f\"  {item['symbol']:12s} {item['sector']:25s} {len(df2023)} backtest days\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Refresh Data (run only when needed)\n",
    "Re-fetch latest data from Fyers. Skip this cell if data is already up to date."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Uncomment and run to re-select basket and refresh data\n",
    "# !cd /root/trading_bot && env/bin/python -u permanent_grid/select_basket_2023.py"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Basket Overview — Correlation & Volatility"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Build returns matrix for basket stocks\n",
    "returns = {}\n",
    "prices = {}\n",
    "for item in basket:\n",
    "    fsym = item['fyers_symbol']\n",
    "    df = daily_data[fsym].sort_values('date')\n",
    "    ret = df['close'].pct_change().dropna()\n",
    "    ret.index = range(len(ret))\n",
    "    returns[item['symbol']] = ret\n",
    "    prices[item['symbol']] = df.set_index('date')['close']\n",
    "\n",
    "ret_df = pd.DataFrame(returns).dropna()\n",
    "corr = ret_df.corr()\n",
    "\n",
    "# Heatmap\n",
    "fig, axes = plt.subplots(1, 2, figsize=(18, 6))\n",
    "\n",
    "im = axes[0].imshow(corr.values, cmap='RdYlGn_r', vmin=-0.2, vmax=0.6)\n",
    "axes[0].set_xticks(range(len(corr))); axes[0].set_xticklabels(corr.columns, rotation=45, ha='right')\n",
    "axes[0].set_yticks(range(len(corr))); axes[0].set_yticklabels(corr.index)\n",
    "for i in range(len(corr)):\n",
    "    for j in range(len(corr)):\n",
    "        axes[0].text(j, i, f'{corr.iloc[i,j]:.2f}', ha='center', va='center', fontsize=8)\n",
    "axes[0].set_title('Pairwise Correlation (daily returns)')\n",
    "plt.colorbar(im, ax=axes[0], shrink=0.8)\n",
    "\n",
    "# Volatility bar\n",
    "vol = ret_df.std() * np.sqrt(252) * 100\n",
    "axes[1].barh(vol.sort_values().index, vol.sort_values().values, color='steelblue', alpha=0.7)\n",
    "axes[1].set_xlabel('Annualized Volatility %')\n",
    "axes[1].set_title('Basket Stock Volatility')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "avg_corr = corr.mean()\n",
    "print(f'\\nAvg pairwise correlation: {corr.where(np.triu(np.ones(corr.shape), k=1).astype(bool)).stack().mean():.3f}')\n",
    "print(f'Max pairwise correlation: {corr.where(np.triu(np.ones(corr.shape), k=1).astype(bool)).stack().max():.3f}')"
   ]
  },
