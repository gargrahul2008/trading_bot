  "entry": {
    "entry_buffer_type": "points",
    "entry_buffer_points": 0.0,
    "entry_buffer_pct": 0.0,
    "entry_buffer_atr_multiplier": 0.1,
    "round_to_whole_number": true,
    "round_to_whole_number_tolerance_pct": 0.1
  },

  "stop_loss": {
    "sl_buffer_type": "points",
    "sl_buffer_points": 0.0,
    "sl_buffer_pct": 0.0,
    "sl_buffer_atr_multiplier": 0.1,
    "stop_lookback_bars": 2
  },

  "target": {
    "risk_reward": 1.0,
    "target_mode": "signal_candle_range"
  },

  "trade_limits": {
    "max_trades_per_symbol_per_day": 10,
    "max_total_trades_per_day": null,
    "max_open_positions": null,
    "one_active_position_per_symbol": true,
    "max_pending_setups_per_symbol": 1
  },

  "risk": {
    "initial_capital": 1000000,
    "position_sizing_mode": "fixed_qty",
    "fixed_qty": 1,
    "risk_per_trade_pct": 0.25,
    "risk_per_trade_amount": null,
    "capital_per_trade_pct": 10.0,
    "capital_per_trade_amount": null,
    "max_daily_loss_pct": 1.0,
    "close_positions_on_daily_loss_hit": false
