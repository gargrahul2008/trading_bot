{
  "strategy_name": "44_SMA_UPTREND_PULLBACK_SCANNER",

  "market": {
    "timezone": "Asia/Kolkata",
    "market_start_time": "09:15",
    "market_end_time": "15:30",
    "no_new_entry_after": "15:10",
    "force_exit_time": "15:15",
    "continuous_session": false
  },

  "timeframes": {
    "timeframe": "15min"
  },

  "scanner": {
    "sma_length": 44,
    "touch_tolerance_mode": "atr",
    "touch_tolerance_pct": 0.6,
    "touch_tolerance_atr_multiplier": 0.2,
    "require_ma_within_signal_range": true,
    "ma_slope_lookback": 5,
    "min_ma_slope_pct": 0.0,
    "move_away_mode": "atr",
    "move_away_pct": 2.0,
    "atr_length": 14,
    "move_away_atr_multiplier": 0.6,
    "minimum_touch_number": 2,
    "sequence_reset_mode": "atr",
    "sequence_reset_pct": 2.0,
    "sequence_reset_atr_multiplier": 0.6,
    "sequence_reset_consecutive_bars": 2,
    "emit_once_per_touch_event": true,
    "emit_signal_bars_within_cluster": false,
    "use_only_completed_candles": true,
    "allow_long": true,
    "allow_short": true,
    "setup_expiry_bars": 3
  },

  "signal_candle": {
    "min_close_position": 0.6,
    "allow_hammer_exception": true,
    "hammer_max_opposite_wick_ratio": 0.15,
    "hammer_max_body_ratio": 0.30,
    "skip_close_position_check_for_same_color_candle": false
  },

  "ma200_filter": {
    "ma_length": 200,
    "nearby_tolerance_mode": "atr",
    "nearby_tolerance_pct": 5.0,
    "nearby_tolerance_atr_multiplier": 1.5,
    "merged_ma_gap_atr_multiplier": 0.0
