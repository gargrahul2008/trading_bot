  "trade_filters": {
    "exclude_trend_class_b": true,
    "min_trend_class_c_slope_pct": -1.5,
    "min_daily_volume": 100000.0,
    "min_entry_price": 15.0
  },

  "setup_quality": {
    "swing_best_min_bars": 4,
    "swing_best_max_bars": 6,
    "swing_short_max_bars": 3,
    "swing_bad_min_bars": 16,
    "double_bottom_tolerance_mode": "atr",
    "double_bottom_tolerance_pct": 0.5,
    "double_bottom_tolerance_atr_multiplier": 0.15,
    "resistance_flip_tolerance_mode": "atr",
    "resistance_flip_tolerance_pct": 0.5,
    "resistance_flip_tolerance_atr_multiplier": 0.15,
    "resistance_flip_swing_lookback": 3,
    "resistance_flip_lookback_bars": 200,
    "resistance_flip_min_touches": 2,
    "ongoing_range_width_mode": "atr",
    "ongoing_range_max_width_pct": 5.0,
    "ongoing_range_max_width_atr_multiplier": 1.8,
    "ongoing_range_min_bars": 4,
    "close_range_lookback_bars": 10,
    "violent_pullback_max_decline_atr_multiplier": 1.0,
    "violent_pullback_min_bars": 3,
    "violent_pullback_recent_bars": 5,
    "violent_pullback_recent_decline_atr_multiplier": 1.3
