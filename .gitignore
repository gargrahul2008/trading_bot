# Runtime state & trade data (live bot — changes constantly, may contain sensitive data)
strategies/*/state/
strategies/*/st/
strategies/*/st

# Per-account (multi-account host) runtime state, logs, and env — never commit.
# account.env names the whitelisted IP; state/ holds live positions. See docs/multi_account_*.md
# Layout is accounts/<user>/<strategy>/state/, so match state/logs at any depth.
accounts/**/state/
accounts/**/logs/
accounts/**/*.env

# Backtest data cache (large binary files, re-downloadable)
backtest/cache/
backtest/ticks/

# Permanent-grid data cache (large, re-downloadable via fetch_*/screen scripts)
permanent_grid/data/*.pkl
permanent_grid/data/bhav_cache/

# Market data (large, re-downloadable)
data/

# Backtest/live artifacts (generated output — not source)
artifacts/

# dashboard agent secret (see webapp/agent.env.example)
webapp/agent.env

# dashboard API secrets (see webapp/dashboard.env.example)
webapp/dashboard.env
webapp/web/node_modules/
webapp/web/dist/
webapp/api/.venv/
webapp/web/tsconfig.tsbuildinfo
