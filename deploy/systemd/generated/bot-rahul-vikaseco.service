[Unit]
Description=Fyers bot: rahul/vikaseco
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/trading_bot
EnvironmentFile=/opt/trading_bot/accounts/rahul/account.env
ExecStart=/opt/trading_bot/.venv/bin/python run_strategy.py --config accounts/rahul/vikaseco/config.json
Restart=always
RestartSec=5
SyslogIdentifier=bot-rahul-vikaseco

[Install]
WantedBy=multi-user.target
