[Unit]
Description=Dashboard Fyers agent (IP-bound) for account piyush
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/trading_bot
# The SAME account.env as this user's bots: identity, and the proxy that puts
# these calls on the account's whitelisted IP.
EnvironmentFile=/root/trading_bot/accounts/piyush/account.env
# AGENT_TOKEN is the shared secret the dashboard authenticates with. Keep it out
# of account.env (which is per-account) and out of the repo.
EnvironmentFile=/root/trading_bot/webapp/agent.env
ExecStart=/root/trading_bot/env/bin/python -m webapp.agent.main \
    --user piyush --port 9103 --per-min 60
Restart=always
RestartSec=10
SyslogIdentifier=agent-piyush

[Install]
WantedBy=multi-user.target
