# Shared secret the dashboard uses to authenticate to every account agent.
# Copy to webapp/agent.env (gitignored) and generate a real value:
#
#     python3 -c "import secrets; print('AGENT_TOKEN=' + secrets.token_urlsafe(32))" > webapp/agent.env
#     chmod 600 webapp/agent.env
#
# The agents bind loopback only, but anything running on the host could reach
# them and place a real order, so the token is required even there.
AGENT_TOKEN=replace-me
