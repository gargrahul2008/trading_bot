# Dashboard API secrets. Copy to webapp/dashboard.env (gitignored).
#
#   webapp/api/.venv/bin/python -c "import sys; sys.path.insert(0,'webapp/api'); \
#     from app.auth import hash_password; print('DASHBOARD_PASSWORD_HASH=' + hash_password('your-password'))"
#   python3 -c "import secrets; print('SESSION_SECRET=' + secrets.token_urlsafe(32))"
#
# The hash is full of "$", which every layer that carries an environment
# variable treats as a variable reference and silently blanks — leaving a
# truncated hash that can never match any password. A file avoids that.
DASHBOARD_PASSWORD_HASH=replace-me
SESSION_SECRET=replace-me
# Secure cookies need HTTPS. Only false for a plain-http local run.
COOKIE_SECURE=true
